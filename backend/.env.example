# ==============================================
# QuizVerse AI - Backend Environment Variables Example
# Copy this file to .env and fill in your custom values
# ==============================================

NODE_ENV=development
PORT=5000

# --- Database (MySQL / XAMPP / MariaDB) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=quizverse_db
DB_USER=root
DB_PASS=

# --- JWT Secret ---
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# --- Gemini AI Key ---
# Retrieve from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# --- Email (SMTP Configuration for OTP) ---
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
EMAIL_FROM=QuizVerse AI <your_email@gmail.com>

# --- Client URL (Frontend Link) ---
CLIENT_URL=http://localhost:5173

# --- File Upload Config ---
MAX_FILE_SIZE=5242880
